<script>
(function(){

const grid = document.getElementById("docGrid");
const searchInput = document.getElementById("searchInput");
const filterBtns = document.querySelectorAll(".filter-btn");

const modal = document.getElementById("modal");
const modalTitle = document.getElementById("modalTitle");
const modalMeta = document.getElementById("modalMeta");
const modalSummary = document.getElementById("modalSummary");
const btnAbrir = document.getElementById("btnAbrir");
const btnDescargar = document.getElementById("btnDescargar");
const btnCerrar = document.getElementById("btnCerrar");
const btnClose = document.getElementById("modalClose");

let term = "";
let activeFilter = "all";

function applyFilters(){
  const cards = grid.querySelectorAll(".card");
  cards.forEach(card=>{
    const matchesType = activeFilter==="all" || card.dataset.type===activeFilter;
    const searchText = (card.dataset.title + " " + card.dataset.tags).toLowerCase();
    const matchesSearch = searchText.includes(term);
    card.classList.toggle("hidden", !(matchesType && matchesSearch));
  });
}

searchInput.addEventListener("input", e=>{
  term = e.target.value.toLowerCase();
  applyFilters();
});

filterBtns.forEach(btn=>{
  btn.addEventListener("click", ()=>{
    filterBtns.forEach(b=>b.classList.remove("active"));
    btn.classList.add("active");
    activeFilter = btn.dataset.filter;
    applyFilters();
  });
});

grid.addEventListener("click", e=>{
  const card = e.target.closest(".card");
  if(!card) return;

  modalTitle.textContent = card.dataset.title;
  modalMeta.textContent = card.dataset.version ? "Version: " + card.dataset.version : "";
  modalSummary.textContent = card.dataset.summary;

  const link = card.dataset.link;
  const pdf  = card.dataset.pdf;

  btnAbrir.onclick = () => { if(link) window.open(link, "_blank"); };

  if(pdf){
    btnDescargar.classList.remove("hidden");
    btnDescargar.onclick = ()=> window.open(pdf, "_blank");
  } else {
    btnDescargar.classList.add("hidden");
    btnDescargar.onclick = null;
  }

  modal.classList.add("open");
});

function closeModal(){
  modal.classList.remove("open");
}

btnCerrar.onclick = closeModal;
btnClose.onclick = closeModal;
modal.addEventListener("click", e=>{ if(e.target===modal) closeModal(); });
document.addEventListener("keydown", e=>{ if(e.key==="Escape") closeModal(); });

})();
</script>

