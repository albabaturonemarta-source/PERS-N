<style>
/* ============================================================
   =   NEW PERFORMANCE-STYLE DOCUMENT CENTER (PERSÁN)         =
   ============================================================ */

:root{
  --brand:#007fa3;
  --brand-dark:#005f7c;
  --bg:#e6f4f7;
  --card:white;
  --text:#00333f;
  --radius:16px;
}

body{
  margin:0;
  font-family:'Segoe UI', Arial;
  background:var(--bg);
  color:var(--text);
}

.container{
  max-width:1100px;
  margin:auto;
  padding:40px 22px 80px;
}

.title{
  text-align:center;
  font-size:36px;
  font-weight:800;
  margin:0 0 8px;
  color:var(--brand-dark);
}

.subtitle{
  text-align:center;
  font-size:18px;
  margin:0 0 35px;
  color:var(--brand);
}

/* Search */
.search-row{
  display:flex;
  justify-content:center;
  margin-bottom:25px;
}

#searchInput{
  padding:14px 18px;
  width:100%;
  max-width:520px;
  border-radius:999px;
  border:2px solid var(--brand);
  font-size:16px;
  outline:none;
}
#searchInput:focus{
  border-color:var(--brand-dark);
  box-shadow:0 0 0 3px rgba(0,127,163,.25);
}

/* Filters */
.filters{
  display:flex;
  justify-content:center;
  gap:12px;
  margin-bottom:25px;
  flex-wrap:wrap;
}

.filter-btn{
  padding:10px 20px;
  border-radius:999px;
  border:1px solid var(--brand);
  background:#f0fafc;
  color:var(--brand);
  font-weight:700;
  cursor:pointer;
  transition:.2s;
}

.filter-btn:hover{
  background:var(--brand);
  color:white;
}

.filter-btn.active{
  background:var(--brand);
  color:white;
  box-shadow:0 4px 10px rgba(0,0,0,.15);
}

/* GRID */
.grid{
  display:grid;
  gap:28px;
  grid-template-columns:repeat(auto-fit, minmax(280px,1fr));
}

/* Card */
.card{
  background:white;
  border-radius:var(--radius);
  padding:24px 22px;
  border:1px solid #c7e1e8;
  box-shadow:0 4px 10px rgba(0,0,0,.08);
  cursor:pointer;
  transition:transform .2s ease, box-shadow .2s ease;
}

.card:hover{
  transform:translateY(-4px);
  box-shadow:0 6px 14px rgba(0,0,0,.12);
}

.card-title{
  margin:0 0 8px;
  font-size:20px;
  font-weight:700;
  color:var(--brand-dark);
}

.card-meta{
  font-size:14px;
  opacity:.8;
  margin-bottom:12px;
}

.tags{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
}

.tag{
  padding:5px 12px;
  background:#eef6f8;
  border-radius:999px;
  font-size:12px;
  font-weight:700;
  color:var(--brand-dark);
}

.hidden{display:none}

/* Modal */
#modal{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.45);
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
  opacity:0;
  pointer-events:none;
  transition:.25s;
  z-index:999;
}

#modal.open{
  opacity:1;
  pointer-events:auto;
}

.modal-content{
  background:white;
  padding:32px;
  border-radius:18px;
  width:100%;
  max-width:550px;
  position:relative;
  box-shadow:0 6px 16px rgba(0,0,0,.25);
}

.close-btn{
  position:absolute;
  top:15px;
  right:15px;
  background:none;
  border:none;
  font-size:22px;
  cursor:pointer;
}

.modal-title{
  margin:0 0 10px;
  font-size:26px;
  font-weight:800;
  color:var(--brand-dark);
}

.modal-meta{
  margin-bottom:14px;
  opacity:.8;
}

.modal-summary{
  font-size:16px;
  line-height:1.5;
}

.modal-actions{
  margin-top:30px;
  display:flex;
  justify-content:flex-end;
  gap:12px;
}

.btn{
  padding:12px 18px;
  border-radius:12px;
  font-weight:700;
  cursor:pointer;
  border:none;
  font-size:14px;
}

.btn-primary{
  background:var(--brand);
  color:white;
}

.btn-secondary{
  background:#ddd;
}

</style>
</head>

