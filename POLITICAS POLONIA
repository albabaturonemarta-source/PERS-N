  <!-- ================ MODAL ================ -->
  <div id="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal-content">
      <button class="close-btn" id="modalClose" aria-label="Close">✕</button>
      <h2 class="modal-title" id="modalTitle"></h2>
      <div class="modal-meta" id="modalMeta"></div>
      <div class="modal-summary" id="modalSummary"></div>
      <div class="modal-actions">
        <button class="btn btn-secondary" id="btnCerrar">Close</button>
        <button class="btn btn-primary" id="btnAbrir">Open document</button>
      </div>
    </div>
  </div>

  <script>
    (function(){
      const grid = document.getElementById('docGrid');
      const searchInput = document.getElementById('searchInput');
      const filterBtns = Array.from(document.querySelectorAll('.filter-btn'));

      const modal = document.getElementById('modal');
      const modalTitle = document.getElementById('modalTitle');
      const modalMeta = document.getElementById('modalMeta');
      const modalSummary = document.getElementById('modalSummary');
      const btnAbrir = document.getElementById('btnAbrir');
      const btnCerrar = document.getElementById('btnCerrar');
      const btnClose = document.getElementById('modalClose');

      let term = "";
      let activeFilter = "all";

      function applyFilters(){
        const cards = grid.querySelectorAll('.card');
        cards.forEach(card=>{
          const matchesType = activeFilter === "all" || card.dataset.type === activeFilter;
          const title = (card.dataset.title || "").toLowerCase();
          const tags = (card.dataset.tags || "").toLowerCase();
          const matchesSearch = (title + " " + tags).includes(term);
          card.classList.toggle("hidden", !(matchesType && matchesSearch));
        });
      }

      searchInput.addEventListener("input", e=>{
        term = (e.target.value || "").toLowerCase();
        applyFilters();
      });

      filterBtns.forEach(btn=>{
        btn.addEventListener("click", ()=>{
          filterBtns.forEach(b=>b.classList.remove("active"));
          btn.classList.add("active");
          activeFilter = btn.dataset.filter;
          applyFilters();
        });
      });

      grid.addEventListener("click", e=>{
        const card = e.target.closest(".card");
        if(!card) return;

        modalTitle.textContent = card.dataset.title || '';
        modalMeta.textContent = card.dataset.version ? `Version: ${card.dataset.version}` : "";
        modalSummary.textContent = card.dataset.summary || '';

        const link = card.dataset.link || "";
        btnAbrir.onclick = () => { if(link) window.open(link, "_blank"); };

        modal.classList.add("open");
      });

      function closeModal(){
        modal.classList.remove("open");
      }
      btnCerrar.onclick = closeModal;
      btnClose.onclick = closeModal;
      modal.addEventListener("click", e=>{ if(e.target===modal) closeModal(); });
      document.addEventListener("keydown", e=>{ if(e.key==="Escape") closeModal(); });

      applyFilters();
    })();
  </script>

