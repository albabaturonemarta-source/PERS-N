<style>
/* ======================================= */
/*   ESTILO COMPACTO Y ESTABLE             */
/* ======================================= */

.perf-section {
  padding: 26px 16px;
  background: #e6f4f7;
  border-radius: 12px;
  border: 1px solid #c7e1e8;
  font-family: 'Segoe UI', system-ui, sans-serif;
}

/* Header */
.perf-header h1 {
  font-size: 1.4rem;
  color: #007fa3;
  margin: 0 0 6px;
  text-align: center;
}
.perf-subtitle {
  color: #007fa3;
  font-size: .88rem;
  margin: 0 auto;
  max-width: 560px;
  text-align: center;
}

/* Tabs */
.access-tabs {
  display: flex;
  gap: 10px;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 16px;
}
.access-tab {
  padding: 6px 14px;
  border-radius: 999px;
  background: #eef6f8;
  border: 1px solid #d7e8ed;
  font-weight: 700;
  cursor: pointer;
  color: #004b5a;
  font-size: .85rem;
  transition: .2s ease;
}
.access-tab:hover { background: #e3f1f4; }
.access-tab.is-active {
  background: #007fa3;
  color: #fff;
  border-color: #007fa3;
  box-shadow: 0 4px 12px rgba(0,127,163,.2);
}

/* Panels: solo uno visible */
.access-panel { display: none; }
.access-panel.is-active { display: block; }

/* Grid compacta y centrada (para que no se ensanche demasiado) */
.access-grid {
  display: grid;
  gap: 14px;
  margin: 16px auto 0;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  align-items: stretch;
  max-width: 900px;
}

/* Cards compactas */
.perf-card {
  background: #ffffff;
  padding: 14px 12px;
  border-radius: 10px;
  border: 1px solid #d4e4e8;
  box-shadow: 0 2px 8px rgba(0,0,0,.06);
  text-align: center;
  text-decoration: none;
  color: #00333f;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  min-height: 120px;
  gap: 6px;
  transition: transform .16s ease, box-shadow .16s ease;
}
.perf-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(0,0,0,.12);
}

/* Icono consistente y centrado */
.perf-icon svg {
  width: 22px;
  height: 22px;
  fill: #007fa3;
  display: block;
  margin-bottom: 6px;
}

/* Título y texto compactos */
.perf-card-title {
  font-size: .9rem;
  font-weight: 700;
  margin: 0 0 2px;
}
.perf-card-text {
  font-size: .74rem;
  color: #3a4a4f;
  margin: 0 0 6px;
  line-height: 1.3;
}

/* Chips */
.access-tags { display: flex; justify-content: center; }
.access-chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 8px;
  border-radius: 999px;
  font-size: .65rem;
  font-weight: 700;
  line-height: 1;
}
.access-chip svg { width: 10px; height: 10px; fill: currentColor; }
.access-chip.muted {
  background: #f1f5f8;
  color: #374956;
  border: 1px solid #dbe3e6;
}
.access-chip.brand {
  background: #e3f4f9;
  color: #007fa3;
  border: 1px solid #c0e3ef;
}

/* Responsive */
@media (max-width:680px){
  .access-grid { max-width: 100%; }
}
@media (max-width:480px){
  .access-grid { grid-template-columns: 1fr 1fr; }
  .perf-card { min-height: 110px; }
}
</style>

<script>
/* Tabs accesibles y exclusivas (solo un panel visible) */
(function(){
  const root = document.getElementById('hr-access');
  if(!root) return;

  const tabs   = Array.from(root.querySelectorAll('.access-tab'));
  const panels = Array.from(root.querySelectorAll('.access-panel'));

  function activate(targetId){
    // Tabs
    tabs.forEach(tab => {
      const isActive = tab.dataset.target === targetId;
      tab.classList.toggle('is-active', isActive);
      tab.setAttribute('aria-selected', String(isActive));
      tab.setAttribute('tabindex', isActive ? '0' : '-1');
    });

    // Panels
    panels.forEach(panel => {
      const isActive = panel.id === targetId;
      panel.classList.toggle('is-active', isActive);
      panel.setAttribute('aria-hidden', String(!isActive));
    });
  }

  // Click en tabs
  root.addEventListener('click', (e) => {
    const btn = e.target.closest('.access-tab');
    if (!btn) return;
    activate(btn.dataset.target);
  });

  // Teclado (Enter / Espacio)
  root.addEventListener('keydown', (e) => {
    const btn = e.target.closest('.access-tab');
    if (!btn) return;
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      activate(btn.dataset.target);
    }
  });

  // Estado inicial (FR por defecto)
  activate('panel-fr');
})();
</script>
