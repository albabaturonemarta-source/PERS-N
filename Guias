<style>
  :root {
    --brand: #007fa3;
    --brand-dark: #005f7c;
    --text: #0f2a30;
    --bg: #f4f8f9;
    --white: #ffffff;
    --radius: 16px;
    --shadow: 0 6px 16px rgba(0,0,0,0.10);
    --transition: .25s ease;
  }

  .guides-section {
    padding: 40px 24px;
    max-width: 1100px;
    margin: auto;
    font-family: "Whitney", "Segoe UI", system-ui, sans-serif;
  }

  .guides-title {
    font-size: 32px;
    color: var(--brand);
    text-align: center;
    margin-bottom: 32px;
    font-weight: 600;
    letter-spacing: .5px;
  }

  .guides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 26px;
  }

  .guide-card {
    background: var(--white);
    border-radius: var(--radius);
    padding: 22px 20px;
    border: 1px solid rgba(0,127,163,.32);
    box-shadow: var(--shadow);
    text-decoration: none;
    color: var(--text);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    transition: var(--transition);
  }

  .guide-card:hover {
    background: var(--brand);
    color: var(--white);
    border-color: var(--brand);
    transform: translateY(-5px);
    box-shadow: 0 10px 24px rgba(0,127,163,.35);
  }

  .guide-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(0,127,163,.12);
    display: grid;
    place-items: center;
    transition: var(--transition);
  }

  .guide-card:hover .guide-icon {
    background: rgba(255,255,255,.25);
  }

  .guide-icon svg {
    width: 26px;
    height: 26px;
    fill: var(--brand);
    transition: var(--transition);
  }

  .guide-card:hover .guide-icon svg {
    fill: var(--white);
    transform: scale(1.1);
  }

  .guide-title {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
  }

  .guide-desc {
    font-size: 14px;
    line-height: 1.4;
    opacity: .75;
  }

  .guide-card:hover .guide-desc {
    opacity: 1;
  }

</style>

