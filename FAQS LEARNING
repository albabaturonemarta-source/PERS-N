<style>
/* =========================================================
   ESTILOS FAQ + CTA FINAL
   Corporativo Persán (#007FA3) • Encapsulado
========================================================= */

.ml-faq-container {
  max-width: 900px;
  margin: 40px auto;
  font-family: inherit;
}

.ml-faq-title {
  font-size: 26px;
  font-weight: 800;
  color: #007FA3;
  margin-bottom: 24px;
}

/* GRID 2 COLUMNAS */
.ml-faq-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px 20px;
}

/* Responsive: 1 columna en móviles */
@media (max-width: 700px) {
  .ml-faq-grid { grid-template-columns: 1fr; }
}

/* Tarjeta FAQ (envoltorio general) */
.ml-faq-item {
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid rgba(0,0,0,0.08);
  background: #ffffff !important;
  transition: box-shadow .25s ease, border-color .25s ease;
}

/* Pregunta (botón) */
.ml-faq-question {
  width: 100%;
  padding: 16px 20px;
  background: #ffffff !important;
  border: none;
  font-size: 15px;
  font-weight: 600;
  text-align: left;
  color: #003c4a !important;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* Flecha */
.ml-faq-question::after {
  content: "›";
  font-size: 20px;
  font-weight: bold;
  color: #007FA3;
  transition: transform .2s ease;
}

/* Rotación cuando se abre */
.ml-faq-item.open .ml-faq-question::after {
  transform: rotate(90deg);
}

/* Hover elegante solo en la pregunta */
.ml-faq-question:hover {
  background: #ffffff !important;
}

/* ========= VISUAL NUEVO PARA LAS RESPUESTAS (solo apariencia) ========= */

/* Contenedor de respuesta: cerrado por defecto */
.ml-faq-answer {
  max-height: 0;
  overflow: hidden;
  padding: 0 20px;                 /* se activa al abrir */
  background: transparent;         /* sin fondo al estar cerrado */
  transition: max-height .35s ease, padding .25s ease, background-color .25s ease;
}

/* Apariencia de card al abrir */
.ml-faq-item.open .ml-faq-answer {
  background: #ffffff;             /* card blanca como en la imagen */
  border-top: 1px solid #e7eef1;
  box-shadow: 0 8px 18px rgba(0,0,0,0.06);
  padding: 16px 20px 20px;         /* ahora sí mostramos padding */
  position: relative;
}

/* Borde izquierdo acento corporativo */
.ml-faq-item.open .ml-faq-answer::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0; bottom: 0;
  width: 4px;
  background: #007FA3;
  border-bottom-left-radius: 12px;
}

/* Sombra general al abrir la tarjeta completa */
.ml-faq-item.open {
  box-shadow: 0 10px 24px rgba(0,0,0,0.08);
  border-color: rgba(0,0,0,0.05);
}

/* Tipografía y espaciado del contenido de la respuesta */
.ml-faq-answer p {
  margin: 12px 0;
  color: #003c4a;
  line-height: 1.5;
}

/* Listas dentro de la respuesta: bullets personalizados */
.ml-faq-answer ul {
  margin: 8px 0 12px 0;
  padding-left: 20px;
}
.ml-faq-answer ul li {
  margin: 6px 0;
  position: relative;
  list-style: none;
}
.ml-faq-answer ul li::before {
  content: "•";
  color: #007FA3;
  font-weight: 900;
  display: inline-block;
  width: 16px;
  margin-left: -16px;
}

/* Enlaces tipo botón ya existentes */
.ml-link-btn {
  display: inline-block;
  margin-top: 6px;
  padding: 8px 14px;
  border-radius: 8px;
  background: #e8f5f9;
  color: #005c72 !important;
  text-decoration: none;
  font-weight: 600;
  border: 1px solid rgba(0, 127, 163, 0.25);
}
.ml-link-btn:hover {
  background: #d8eef5;
}

/* ================= CTA FINAL ================= */
.ml-faq-cta-wrap {
  margin-top: 28px;
  display: flex;
  justify-content: flex-start; /* cambia a center si lo quieres centrado */
}

.ml-faq-cta {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 28px;
  background: #007FA3 !important;
  color: #ffffff !important;
  font-size: 16px;
  font-weight: 700;
  text-decoration: none;
  border-radius: 50px;
  box-shadow: 0 6px 16px rgba(0, 127, 163, 0.28);
  transition: transform .25s ease, box-shadow .25s ease;
}

/* Icono */
.ml-cta-icon { flex-shrink: 0; }

/* Hover sin cambio de color */
.ml-faq-cta:hover {
  transform: translateY(-3px);
  background: #007FA3 !important;
  box-shadow: 0 10px 20px rgba(0, 127, 163, 0.35);
}

/* Bloqueo de estilos heredados agresivos */
.ml-faq-cta,
.ml-faq-cta *,
.ml-faq-cta::before,
.ml-faq-cta::after {
  background-color: #007FA3 !important;
  color: #ffffff !important;
}
</style>

<script>
/* =========================================================
   ACORDEÓN – LÓGICA (abre uno y cierra el resto)
   + Accesibilidad (aria-expanded)
   + Recalcular altura al redimensionar
========================================================= */

(function() {
  const items = document.querySelectorAll('.ml-faq-item');

  function setAnswerHeight(answer, open) {
    if (!answer) return;
    if (open) {
      // Forzar lectura de scrollHeight (layout thrash controlado)
      const h = answer.scrollHeight;
      answer.style.maxHeight = h + 'px';
    } else {
      answer.style.maxHeight = null;
    }
  }

  items.forEach(item => {
    const btn = item.querySelector('.ml-faq-question');
    const answer = item.querySelector('.ml-faq-answer');
    if (!btn || !answer) return;

    btn.addEventListener('click', () => {
      const isOpen = item.classList.contains('open');

      // Cierra otros
      document.querySelectorAll('.ml-faq-item.open').forEach(openItem => {
        if (openItem !== item) {
          openItem.classList.remove('open');
          const a = openItem.querySelector('.ml-faq-answer');
          const b = openItem.querySelector('.ml-faq-question');
          setAnswerHeight(a, false);
          if (b) b.setAttribute('aria-expanded', 'false');
        }
      });

      // Alterna este
      if (!isOpen) {
        item.classList.add('open');
        setAnswerHeight(answer, true);
        btn.setAttribute('aria-expanded', 'true');
      } else {
        item.classList.remove('open');
        setAnswerHeight(answer, false);
        btn.setAttribute('aria-expanded', 'false');
      }
    });

    // Estado inicial accesible
    btn.setAttribute('aria-expanded', 'false');
  });

  // Recalcular altura al redimensionar (para que no se corte el contenido abierto)
  window.addEventListener('resize', () => {
    document.querySelectorAll('.ml-faq-item.open .ml-faq-answer').forEach(a => {
      a.style.maxHeight = a.scrollHeight + 'px';
    });
  });
})();
</script>
